# این فایل رو کپی کن و اسمش رو بذار .env  (فایل .env توی git نمی‌ره)
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx
# مدل صدا (پیش‌فرض eleven_v4). اگه حسابت v4 نداره: eleven_v3
ELEVENLABS_MODEL=eleven_v4
# اختیاری: پروکسی برای دانلود/ساخت صدا از ایران (پورت برنامه‌ی VPN خودت)
# HTTPS_PROXY=http://127.0.0.1:10809
VOICE_ALI=
VOICE_SARA=
VOICE_AYLIN=